# Example environment for Aegis
COMPOSE_PROJECT_NAME=curium
TZ=Europe/Athens

# Used by Traefik router rules in compose
AUTO_HOST=${COMPOSE_PROJECT_NAME}.localhost

# Image names used by compose
BACK_END_IMAGE=curium-be:0.0.1
FRONT_END_IMAGE=curium-fe:0.0.1

# Neo4j credentials (change in your real .env)
NEO4J_USER=neo4j
NEO4J_PASS=change-me
NEO4J_AUTH=${NEO4J_USER}/${NEO4J_PASS}

# Web UI / API login and JWT signing key (change all three)
JWT_SECRET=change-me
APP_USER=default
APP_PASSWORD=default
